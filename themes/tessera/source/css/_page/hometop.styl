// Tessera 首页开屏模块（home_top）
if hexo-config('home_top') && hexo-config('home_top.enable')
  #home-top
    display: flex
    margin: 0 auto
    padding: 96px 15px 0
    max-width: 1400px
    width: 100%

    // 超大屏（≥2000px）跟随 .layout：max-width 从定值切到 60% 视口宽，
    // 否则开屏模块停在 1400px，比下方文章区（.layout 同断点为 60%）窄一截
    +minWidth2000()
      max-width: 60%

    // ≤900px 与下方布局同步：侧栏消失，开屏模块堆叠
    +maxWidth900()
      flex-direction: column
      gap: 16px

    +maxWidth768()
      padding: 90px 12px 0

  // 有开屏模块时，正文区的顶部留白收窄
  #home-top ~ .layout
    padding-top: 16px

  // 左列与下方文章区同宽（74%），右侧推荐位与侧栏同宽（26% - 15px 内距）
  .home-top-left
    display: flex
    flex-direction: column
    gap: 16px
    width: 74%
    min-width: 0

    +maxWidth900()
      width: 100%

  // ---- 标语卡 + 图标墙 ----
  .htop-banner
    @extend .cardHover
    position: relative
    overflow: hidden
    padding: 34px 38px
    height: 256px

    +maxWidth768()
      padding: 24px 22px
      height: 200px

    .htop-text
      position: relative
      z-index: 2

    .htop-title
      color: var(--text-highlight-color)
      font-weight: 700
      font-size: 2.3em
      line-height: 1.35

      +maxWidth768()
        font-size: 1.7em

    .htop-site
      margin-top: 14px
      color: var(--card-meta)
      font-weight: 600
      font-size: .85em
      letter-spacing: 2px

    // 图标墙：两行反向滚动，左缘渐隐过渡，整体轻微倾斜
    .htop-iconwall
      position: absolute
      top: 50%
      right: -30px
      z-index: 1
      width: 58%
      // 无缝滚动（轨道 2 份图标平移 -50%）要求「可视窗口 ≤ 一份图标宽度」。
      // 超大屏下 home-top 变宽会把窗口撑大、超过一份宽度，回卷处露出空档而跳帧。
      // 故把窗口封顶在 1400px 断点时的已知良好宽度（58% × 74% × (1400-30) ≈ 588px），
      // 再宽的屏幕也不增长，无缝前提恒成立，与图标数量无关。
      max-width: 588px
      transform: translateY(-50%) rotate(-8deg)
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 92%, transparent)
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 92%, transparent)

      +maxWidth768()
        right: -50px
        width: 80%
        opacity: .4

    .htop-iconrow
      overflow: hidden
      margin: 13px 0

    // 动画放在单一轨道上（每行仅 1 个合成层）：避免多份图标各自按设备像素取整
    // 而在接缝处产生 1px 抖动（闪烁）。translate3d + backface 稳定 GPU 合成
    .htop-icontrack
      display: flex
      width: max-content
      animation: htop-marquee 28s linear infinite
      animation-delay: -14s // 负延迟：进场即处于播放中途，不暴露起始帧
      backface-visibility: hidden
      will-change: transform

    .htop-iconset
      display: flex
      flex-shrink: 0

    // 反向行：不用 animation-direction（迭代边界语义不可靠），
    // 而是整行镜像 + 图标再翻回 -- 与第一行跑同一个正向动画，行为逐像素等价
    .htop-reverse
      transform: scaleX(-1)

    .htop-reverse .htop-tile
      transform: scaleX(-1)

    .htop-reverse .htop-icontrack
      animation-delay: -7s // 与第一行错相位，避免两行同步感

    .htop-tile
      display: flex
      flex-shrink: 0
      margin-right: 14px // 用 margin 而非 gap：保证 -50% 位移无缝循环
      justify-content: center
      align-items: center
      width: 62px
      height: 62px
      border-radius: 16px
      color: #fff
      font-size: 30px
      box-shadow: 0 6px 14px rgba(0, 0, 0, .14)

      +maxWidth768()
        width: 48px
        height: 48px
        border-radius: 12px
        font-size: 23px

  // ---- 分类入口卡 ----
  .htop-categories
    display: flex
    gap: 16px

    +maxWidth768()
      gap: 10px

  // 镂空 + 磨砂玻璃：与站点卡片同一套设计令牌，配置的彩色由图标承载（渐变裁切进字形）
  .htop-cat
    position: relative
    overflow: hidden
    display: flex
    flex: 1
    align-items: center
    padding: 0 24px
    height: 84px
    border: 1px solid var(--glass-border)
    border-radius: var(--card-radius)
    background: var(--glass-bg)
    box-shadow: var(--card-box-shadow)
    backdrop-filter: saturate(180%) blur(var(--glass-blur))
    -webkit-backdrop-filter: saturate(180%) blur(var(--glass-blur))
    color: var(--text-highlight-color) !important
    transition: border-color .3s ease, box-shadow .3s ease, transform .3s ease

    +maxWidth768()
      padding: 0 14px
      height: 64px

    .htop-cat-name
      position: relative
      z-index: 2
      font-weight: 700
      font-size: 1.18em

      +maxWidth768()
        font-size: 1em

    // 半透明线框图标：描边勾勒字形轮廓、填充透明，颜色取自各卡的 accent
    .htop-cat-icon
      position: absolute
      right: 14px
      bottom: -12px
      z-index: 1
      font-size: 56px
      transform: rotate(-15deg)
      transition: transform .4s ease, opacity .4s ease
      -webkit-text-stroke: 2px var(--cat-accent)
      -webkit-text-fill-color: transparent
      opacity: .5

      +maxWidth768()
        font-size: 40px
        -webkit-text-stroke-width: 1.5px

    &:hover
      border-color: var(--cat-accent)
      box-shadow: var(--card-hover-box-shadow)
      transform: translateY(-3px)

      .htop-cat-icon
        opacity: .85
        transform: rotate(0deg) scale(1.15)

  // ---- 推荐位横幅 ----
  // ---- 站点实时状态台（自定义动态组件：LIVE 脉冲 + 轨道环 + 实时时钟 + 统计 + 最新文轮播）----
  .htop-console
    position: relative
    overflow: hidden
    margin-left: 15px
    width: calc(26% - 15px)
    display: flex
    flex-direction: column
    padding: 16px 18px 14px
    border-radius: var(--card-radius)
    border: 1px solid rgba(99, 125, 255, .35)
    background: linear-gradient(155deg, rgba(22, 26, 48, .97) 0%, rgba(30, 36, 70, .97) 55%, rgba(20, 24, 46, .97) 100%)
    box-shadow: 0 12px 32px -8px rgba(20, 26, 64, .45), inset 0 1px 0 rgba(255, 255, 255, .06)
    color: #e8ecff
    backdrop-filter: saturate(160%) blur(10px)
    -webkit-backdrop-filter: saturate(160%) blur(10px)
    transition: border-color .3s ease, box-shadow .3s ease

    // 顶部流光描边
    &::before
      content: ''
      position: absolute
      top: 0
      left: 8%
      right: 8%
      height: 1px
      background: linear-gradient(90deg, transparent, rgba(120, 145, 255, .85), transparent)

    // 角落光斑
    &::after
      content: ''
      position: absolute
      top: -42px
      right: -42px
      width: 150px
      height: 150px
      background: radial-gradient(circle, rgba(99, 125, 255, .22), transparent 65%)
      pointer-events: none

    +maxWidth900()
      margin-left: 0
      width: 100%
      min-height: 190px

    .hc-head
      display: flex
      align-items: center
      gap: 7px
      font-size: .72em
      font-weight: 700
      letter-spacing: 2.5px
      color: rgba(200, 212, 255, .72)

      .hc-live-dot
        position: relative
        width: 8px
        height: 8px
        border-radius: 50%
        background: #3ddc97
        box-shadow: 0 0 8px rgba(61, 220, 151, .8)

        &::after
          content: ''
          position: absolute
          inset: -4px
          border-radius: 50%
          border: 1px solid rgba(61, 220, 151, .6)
          animation: hc-pulse 1.8s ease-out infinite

      .hc-head-sep
        width: 14px
        height: 1px
        background: rgba(120, 140, 220, .4)

    .hc-clock-row
      display: flex
      align-items: baseline
      gap: 10px
      margin-top: 8px
      margin-bottom: 2px

      .hc-clock
        font-size: 2.05em
        font-weight: 700
        font-variant-numeric: tabular-nums
        letter-spacing: 1.5px
        line-height: 1
        color: #fff
        text-shadow: 0 0 18px rgba(99, 125, 255, .55)

      .hc-date
        font-size: .8em
        font-variant-numeric: tabular-nums
        color: rgba(190, 202, 245, .62)

    .hc-orbit
      position: relative
      width: 128px
      height: 108px
      margin: 2px 0
      align-self: center

      .hc-ring
        position: absolute
        left: 50%
        top: 50%
        width: 104px
        height: 104px
        margin: -52px 0 0 -52px
        border-radius: 50%
        border: 1px solid rgba(120, 145, 255, .28)

        &::after
          content: ''
          position: absolute
          inset: 9px
          border-radius: 50%
          border: 1px dashed rgba(120, 145, 255, .16)

      .hc-orb
        position: absolute
        left: 50%
        top: 50%
        width: 6px
        height: 6px
        margin: -3px 0 0 -3px
        border-radius: 50%
        background: #7c93ff
        box-shadow: 0 0 10px rgba(124, 147, 255, .9)

      .hc-orb-a
        animation: hc-orbit 7s linear infinite

      .hc-orb-b
        width: 4px
        height: 4px
        margin: -2px 0 0 -2px
        background: #3ddc97
        box-shadow: 0 0 8px rgba(61, 220, 151, .9)
        animation: hc-orbit 11s linear infinite reverse

      .hc-orb-c
        width: 3px
        height: 3px
        margin: -1.5px 0 0 -1.5px
        background: #ffb454
        box-shadow: 0 0 8px rgba(255, 180, 84, .9)
        animation: hc-orbit 5s linear infinite

      .hc-core
        position: absolute
        left: 50%
        top: 50%
        width: 40px
        height: 40px
        margin: -20px 0 0 -20px
        display: flex
        align-items: center
        justify-content: center
        border-radius: 12px
        background: linear-gradient(145deg, rgba(99, 125, 255, .28), rgba(99, 125, 255, .08))
        border: 1px solid rgba(124, 147, 255, .5)
        color: #aebfff
        font-size: 1.05em
        animation: hc-core-glow 3s ease-in-out infinite

    .hc-stats
      display: flex
      justify-content: space-around
      padding: 4px 0 10px

      a
        display: flex
        flex-direction: column
        align-items: center
        gap: 1px
        color: inherit
        text-decoration: none
        transition: transform .25s ease

        &:hover
          transform: translateY(-2px)

      .hc-num
        font-size: 1.35em
        font-weight: 700
        font-variant-numeric: tabular-nums
        line-height: 1.1
        color: #fff
        text-shadow: 0 0 14px rgba(99, 125, 255, .4)

      .hc-lbl
        font-size: .72em
        letter-spacing: 2px
        color: rgba(190, 202, 245, .55)

    .hc-featured
      position: relative
      display: block
      margin-top: auto
      padding: 10px 12px
      border-radius: 10px
      background: rgba(99, 125, 255, .1)
      border: 1px solid rgba(124, 147, 255, .22)
      text-decoration: none
      transition: border-color .3s ease, background .3s ease

      &:hover
        border-color: rgba(124, 147, 255, .6)
        background: rgba(99, 125, 255, .16)

      .hc-feat-label
        font-size: .68em
        font-weight: 700
        letter-spacing: 2px
        color: rgba(140, 160, 255, .8)

      .hc-feat-title
        margin-top: 3px
        max-height: 2.7em
        overflow: hidden
        font-size: .84em
        font-weight: 600
        line-height: 1.35
        color: #eef1ff
        display: -webkit-box
        -webkit-box-orient: vertical
        -webkit-line-clamp: 2
        transition: opacity .3s ease

      .hc-feat-dots
        display: flex
        gap: 4px
        margin-top: 7px

        i
          width: 5px
          height: 5px
          border-radius: 3px
          background: rgba(124, 147, 255, .3)
          transition: all .3s ease

        .hc-dot-on
          width: 14px
          background: #7c93ff
          box-shadow: 0 0 6px rgba(124, 147, 255, .8)

    .hc-foot
      display: flex
      align-items: center
      margin-top: 9px
      font-family: consolas, Menlo, monospace
      font-size: .68em
      color: rgba(160, 175, 235, .5)

      .hc-cursor
        margin-left: 2px
        color: #7c93ff
        animation: hc-blink 1.1s steps(1) infinite

    @keyframes hc-pulse
      0%
        transform: scale(.6)
        opacity: .9

      100%
        transform: scale(1.9)
        opacity: 0

    @keyframes hc-orbit
      from
        transform: rotate(0deg) translateX(52px)

      to
        transform: rotate(360deg) translateX(52px)

    @keyframes hc-core-glow
      0%, 100%
        box-shadow: 0 0 10px rgba(99, 125, 255, .25)

      50%
        box-shadow: 0 0 22px rgba(99, 125, 255, .55)

    @keyframes hc-blink
      50%
        opacity: 0

  @keyframes htop-marquee
    from
      transform: translate3d(0, 0, 0)

    to
      transform: translate3d(-50%, 0, 0)
